# Defence Gateway AI — development placeholders (demo only, not secrets).
#
# Copy to .env and adjust ONLY if you want to override the defaults:
#     cp .env.example .env
# NEVER commit .env (AGENTS.md). The build never reads .env; Compose uses the
# placeholders below as ${VAR:-default} fallbacks, and app/config.py defaults
# match these values. To let Compose pick up a real .env explicitly:
#     docker compose --env-file .env -f infra/compose.yaml up -d

# --- database (host ports: db 5434, api 8001) ---
POSTGRES_SUPERUSER_PASSWORD=dev-postgres-password
GATEWAY_OWNER_PASSWORD=dev-owner-password
GATEWAY_APP_PASSWORD=dev-app-password

# Used by app/config.py defaults for host-run tests (localhost = host port 5434).
OWNER_DATABASE_URL=postgresql+psycopg://gateway_owner:dev-owner-password@localhost:5434/gateway
APP_DATABASE_URL=postgresql+psycopg://gateway_app:dev-app-password@localhost:5434/gateway
TEST_OWNER_DATABASE_URL=postgresql+psycopg://gateway_owner:dev-owner-password@localhost:5434/gateway_test
TEST_APP_DATABASE_URL=postgresql+psycopg://gateway_app:dev-app-password@localhost:5434/gateway_test

# --- stubbed identity (dev JWT; Keycloak is stubbed — docs/STUBS.md) ---
DEV_JWT_SECRET=dev-only-secret-change-me
DEV_JWT_TTL_SECONDS=7200

# --- AI gateway (provider/model from config, never hardcoded) ---
LLM_PROVIDER=hosted
LLM_MODEL=
HOSTED_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- demo cache (docs/DEMO_SCOPE.md; dev profile only) ---
# Pins the seed dates and data-tool cutoffs so recorded answers stay valid. Demo: 2026-10-07
DEMO_DATE=
LLM_CACHE_ONLY=0
